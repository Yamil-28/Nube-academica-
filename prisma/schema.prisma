generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMINISTRADOR
  DOCENTE
  ESTUDIANTE
}

model Usuario {
  id          Int      @id @default(autoincrement())
  usuario     String   @unique
  nombre      String
  contrasena  String
  rol         Rol
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  @@map("usuarios")
}